{
  "id": "r06-gold-partner-direct",
  "title": "Buffalo Wild Wings and the Amex Gold dining credit: a gold-partner credit counts at direct only where amexGoldDirect is true",
  "refs": ["§13 scenario 3", "§12", "§9.3", "D-029 §5.9", "D-028"],
  "dataNote": "rest = the buffalo_wild_wings profile in src/data/profiles.js (2026-11-12): amexGoldDirect true, no direct delivery, platforms []. The credit copies cards.js amex_gold dining: $10 monthly, plats [gh], goldPartner. Five Guys, the spec's example, is unprofiled for now (D-028).",
  "patch": {
    "rest": {
      "id": "buffalo_wild_wings", "name": "Buffalo Wild Wings", "profiled": true,
      "menu": [
        {"name": "10 Boneless Wings + Fries", "price": 14.79, "dealItem": false},
        {"name": "10 Bone-In Wings + Fries", "price": 17.39, "dealItem": false},
        {"name": "Classic Chicken Sandwich + Fries", "price": 9.49, "dealItem": false},
        {"name": "Buffalo Ranch Chicken Sandwich + Fries", "price": 11.49, "dealItem": false},
        {"name": "All-American Cheeseburger + Fries", "price": 13.29, "dealItem": false},
        {"name": "Original Chicken Dippers + Fries", "price": 10.99, "dealItem": false},
        {"name": "Buffalo Chips", "price": 3.74, "dealItem": false},
        {"name": "Pepsi® Bottle", "price": 2.99, "dealItem": false}
      ],
      "deal": null, "directDelivery": false, "directSvc": null, "amexGoldDirect": true,
      "platforms": [], "markup": {}, "markupEst": true
    },
    "cart": {"0": 1},
    "credits": [{"key": "amex_gold:dining", "name": "Dining credit", "amount": 10, "plats": ["gh"], "goldPartner": true}]
  },
  "cases": [
    {
      "call": "allResults",
      "expect": {"order": ["direct-p"], "net": {"direct-p": 7.47}},
      "work": ["BWW isn't on any app and has no direct delivery, so direct pickup is the only channel. The others are removed, not priced at $0."]
    },
    {
      "call": "calc", "channel": "direct-p",
      "expect": {
        "lines": [["Food", 14.79], ["Tax", 1.26], ["Gas", 0.82], ["Wear", 0.60], ["Card credits", -10], ["TOTAL", 7.47]],
        "gross": 17.47, "credit": 10, "net": 7.47
      },
      "work": [
        "food = 14.79; tax = 14.79 × 8.54% = 1.263066 → 1.26; drive = 0.82 + 0.60 = 1.42",
        "gross = 14.79 + 1.26 + 1.42 = 17.47",
        "The dining credit lists only gh, but it's goldPartner and BWW is amexGoldDirect, so it counts at direct: credit = min(10, 17.47) = 10",
        "net = 17.47 − 10 = 7.47"
      ]
    },
    {
      "call": "calc", "channel": "direct-p",
      "patch": {"rest": {"amexGoldDirect": false}},
      "expect": {"net": 17.47, "credit": 0},
      "work": ["The same credit at a restaurant that isn't a Gold partner does not apply at direct."]
    }
  ]
}
