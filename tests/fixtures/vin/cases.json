    "1HGCM82633A004352"
   ],
   "expect": "ok",
   "work": "values 1 8 7 3 4 8 2 6 3 3 1 0 0 4 3 5 2 x weights 8 7 6 5 4 3 2 10 0 9 8 7 6 5 4 3 2 = 311; 311 % 11 = 3 = 9th char"
  },
