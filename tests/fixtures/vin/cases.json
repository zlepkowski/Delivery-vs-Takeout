   "id": "check digit X",
   "fn": "check",
   "args": [
    "1M8GDM9AXKP042788"
   ],
   "expect": "ok",
   "work": "8+28+48+35+16+12+18+10+0+18+56+0+24+10+28+24+16 = 351; 351 % 11 = 10 -> 'X' = 9th char"
  },
