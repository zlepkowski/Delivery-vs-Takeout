  {
   "id": "clean NHTSA sample with case, hyphen, spaces and a newline",
   "fn": "clean",
   "args": [
    " 1hgcm8-2633a004352\n"
   ],
   "expect": "1HGCM82633A004352",
   "work": "lowercase a-z raised; space, '-', LF dropped"
  },
